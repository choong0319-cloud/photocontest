              </button>
              <button class="btn-sm btn-download" onclick="downloadImage('${item.image}', '${item.grade}학년${item.classNum}반_${item.title}')">
                <i class="fa-solid fa-download"></i> 다운
              </button>
              <button class="btn-sm btn-delete" onclick="deleteSubmission(${item.id})">
                <i class="fa-solid fa-trash"></i> 삭제
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function deleteSubmission(id) {
      if (confirm('해당 작품을 삭제하시겠습니까?')) {
        let submissions = getSubmissions();
        submissions = submissions.filter(item => item.id !== id);
        saveSubmissions(submissions);
        renderAdminDashboard();
      }
    }

    function downloadImage(dataUrl, filename) {
      const link = document.createElement('a');
      link.href = dataUrl;
      link.download = `율곡중_${filename}.jpg`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

