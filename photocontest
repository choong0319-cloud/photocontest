<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>제1회 율곡중학교 학급 사진 콘테스트</title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Noto+Sans+KR:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Libraries (Three.js for 3D Landing, SheetJS for Excel export) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent-color: #38bdf8;
      --accent-hover: #0284c7;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
      --museum-bg: #fcfbf9;
      --museum-text: #1a1a1a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Noto Sans KR', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* 1. Landing Screen (3D Canvas + Interactive Title) */
    #landing-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 100;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      cursor: pointer;
      transition: opacity 0.8s ease, visibility 0.8s;
      background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
    }

    #landing-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .landing-content {
      position: relative;
      z-index: 2;
      padding: 2rem;
      pointer-events: none;
    }

    .badge {
      display: inline-block;
      padding: 6px 16px;
      background: rgba(56, 189, 248, 0.15);
      border: 1px solid var(--accent-color);
      color: var(--accent-color);
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 500;
      margin-bottom: 1.5rem;
      letter-spacing: 1px;
    }

    .landing-title {
      font-size: clamp(2rem, 6vw, 3.8rem);
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 1.5rem;
      text-shadow: 0 10px 30px rgba(0,0,0,0.5);
      background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .tap-instruction {
      font-size: 1.1rem;
      color: var(--accent-color);
      animation: pulse 2s infinite;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.4; transform: translateY(0); }
      50% { opacity: 1; transform: translateY(-5px); }
    }

    /* 2. Main Layout */
    .app-container {
      max-width: 680px;
      margin: 0 auto;
      padding: 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 24px;
    }

    .header-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--accent-color);
    }

    .admin-btn {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .admin-btn:hover {
      border-color: var(--accent-color);
      color: var(--text-main);
    }

    /* Form Styles */
    .form-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      margin-bottom: 30px;
    }

    .form-title {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    label {
      display: block;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    select, input[type="text"], textarea {
      width: 100%;
      background: #0f172a;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
    }

    select:focus, input[type="text"]:focus, textarea:focus {
      border-color: var(--accent-color);
    }

    /* File Upload Box */
    .file-upload-box {
      border: 2px dashed var(--border-color);
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      cursor: pointer;
      background: #0f172a;
      transition: all 0.2s;
      position: relative;
      overflow: hidden;
    }

    .file-upload-box:hover {
      border-color: var(--accent-color);
    }

    .file-upload-box input[type="file"] {
      display: none;
    }

    .upload-icon {
      font-size: 2rem;
      color: var(--accent-color);
      margin-bottom: 8px;
    }

    .preview-img {
      max-width: 100%;
      max-height: 250px;
      border-radius: 8px;
      display: none;
      margin: 0 auto;
      object-fit: contain;
    }

    .submit-btn {
      width: 100%;
      background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
      color: #fff;
      border: none;
      padding: 16px;
      border-radius: 12px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
    }

    .submit-btn:active {
      transform: scale(0.98);
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .modal-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      width: 100%;
      max-width: 450px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

    /* Admin View */
    .admin-container {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background: var(--bg-color);
      z-index: 150;
      display: none;
      flex-direction: column;
      overflow-y: auto;
    }

    .admin-header {
      background: var(--card-bg);
      padding: 16px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .admin-actions {
      display: flex;
      gap: 10px;
    }

    .btn-action {
      background: #0f172a;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-action.excel {
      background: #166534;
      border-color: #22c55e;
      color: #fff;
    }

    .admin-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      padding: 24px;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .photo-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .photo-card-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      background: #000;
    }

    .photo-card-body {
      padding: 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .photo-card-meta {
      font-size: 0.85rem;
      color: var(--accent-color);
      font-weight: 700;
      margin-bottom: 4px;
    }

    .photo-card-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .photo-card-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 16px;
      flex: 1;
      white-space: pre-wrap;
    }

    .photo-card-btns {
      display: flex;
      gap: 8px;
      border-top: 1px solid var(--border-color);
      padding-top: 12px;
    }

    .btn-sm {
      flex: 1;
      padding: 8px;
      border-radius: 6px;
      font-size: 0.8rem;
      border: none;
      cursor: pointer;
      font-weight: 600;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
    }

    .btn-museum { background: #e2e8f0; color: #0f172a; }
    .btn-download { background: var(--accent-color); color: #0f172a; }
    .btn-delete { background: #ef4444; color: #fff; }

    /* Modern Museum Label Modal */
    .museum-label-container {
      background: var(--museum-bg);
      color: var(--museum-text);
      padding: 40px;
      border-radius: 4px;
      width: 100%;
      max-width: 520px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 1px solid #e5e5e5;
      position: relative;
    }

    .museum-label {
      border-left: 3px solid #1a1a1a;
      padding-left: 20px;
    }

    .museum-header {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 6px;
    }

    .museum-title {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #111;
    }

    .museum-year {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      color: #666;
    }

    .museum-artist {
      font-size: 0.95rem;
      font-weight: 500;
      color: #444;
      margin-bottom: 4px;
    }

    .museum-medium {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 0.85rem;
      color: #777;
      margin-bottom: 18px;
      letter-spacing: 0.5px;
    }

    .museum-desc {
      font-size: 0.92rem;
      line-height: 1.6;
      color: #333;
      white-space: pre-line;
      text-align: justify;
    }

    .museum-footer-btn {
      margin-top: 24px;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    @media print {
      body * { visibility: hidden; }
      .museum-label-container, .museum-label-container * { visibility: visible; }
      .museum-label-container { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; }
      .museum-footer-btn { display: none; }
    }
  </style>
</head>
<body>

  <!-- 1. Landing Screen -->
  <div id="landing-screen" onclick="enterApp()">
    <canvas id="landing-canvas"></canvas>
    <div class="landing-content">
      <div class="badge"><i class="fa-solid fa-camera"></i> YULGOK MIDDLE SCHOOL</div>
      <h1 class="landing-title">제1회 율곡중학교<br>학급 사진 콘테스트</h1>
      <div class="tap-instruction">
        <i class="fa-solid fa-hand-pointer"></i> 화면을 터치하여 사진 제출하기
      </div>
    </div>
  </div>

  <!-- 2. Main App Screen -->
  <div class="app-container">
    <header>
      <div class="header-title">율곡중학교 사진 콘테스트</div>
      <button class="admin-btn" onclick="openAdminAuthModal()">
        <i class="fa-solid fa-lock"></i> 관리자
      </button>
    </header>

    <main>
      <form id="photo-form" class="form-card" onsubmit="handleFormSubmit(event)">
        <h2 class="form-title"><i class="fa-solid fa-file-arrow-up" style="color:var(--accent-color)"></i> 작품 제출하기</h2>
        
        <div class="form-group form-row">
          <div>
            <label for="grade-select">학년</label>
            <select id="grade-select" required>
              <option value="">선택</option>
              <option value="1">1학년</option>
              <option value="2">2학년</option>
              <option value="3">3학년</option>
            </select>
          </div>
          <div>
            <label for="class-select">반</label>
            <select id="class-select" required>
              <option value="">선택</option>
              <option value="1">1반</option>
              <option value="2">2반</option>
              <option value="3">3반</option>
              <option value="4">4반</option>
              <option value="5">5반</option>
              <option value="6">6반</option>
              <option value="7">7반</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>사진 업로드</label>
          <div class="file-upload-box" onclick="document.getElementById('photo-input').click()">
            <input type="file" id="photo-input" accept="image/*" required onchange="handleFileSelect(event)">
            <div id="upload-placeholder">
              <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
              <p style="font-weight: 500;">터치하여 사진을 선택하세요</p>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">JPG, PNG 이미지 파일</p>
            </div>
            <img id="image-preview" class="preview-img" alt="미리보기">
          </div>
        </div>

        <div class="form-group">
          <label for="photo-title">작품 제목</label>
          <input type="text" id="photo-title" placeholder="작품의 제목을 입력하세요" required maxlength="50">
        </div>

        <div class="form-group">
          <label for="photo-desc">작품 설명</label>
          <textarea id="photo-desc" rows="4" placeholder="사진에 담긴 학급의 이야기나 설명을 적어주세요." required></textarea>
        </div>

        <button type="submit" class="submit-btn">
          <i class="fa-solid fa-paper-plane"></i> 제출하기
        </button>
      </form>
    </main>
  </div>

  <!-- Admin Login Modal -->
  <div id="admin-auth-modal" class="modal-overlay">
    <div class="modal-card">
      <h3 style="margin-bottom: 16px;"><i class="fa-solid fa-user-shield"></i> 관리자 인증</h3>
      <div class="form-group">
        <label for="admin-pw">비밀번호 입력</label>
        <input type="password" id="admin-pw" placeholder="비밀번호를 입력하세요" onkeyup="if(event.key==='Enter') verifyAdminPw()">
      </div>
      <div style="display: flex; gap: 8px; justify-content: flex-end;">
        <button class="btn-action" onclick="closeModal('admin-auth-modal')">취소</button>
        <button class="btn-action" style="background: var(--accent-color); color: #000; font-weight:700;" onclick="verifyAdminPw()">확인</button>
      </div>
    </div>
  </div>

  <!-- Admin Full Dashboard -->
  <div id="admin-dashboard" class="admin-container">
    <div class="admin-header">
      <h2><i class="fa-solid fa-list-check"></i> 공모전 관리자 시스템</h2>
      <div class="admin-actions">
        <button class="btn-action excel" onclick="exportToExcel()">
          <i class="fa-solid fa-file-excel"></i> 엑셀 다운로드
        </button>
        <button class="btn-action" onclick="closeAdminDashboard()">
          <i class="fa-solid fa-xmark"></i> 닫기
        </button>
      </div>
    </div>
    <div id="admin-photo-grid" class="admin-grid">
      <!-- Dynamically populated -->
    </div>
  </div>

  <!-- Museum Label Modal -->
  <div id="museum-label-modal" class="modal-overlay">
    <div class="museum-label-container">
      <div class="museum-label">
        <div class="museum-header">
          <span class="museum-title" id="m-title">작품 제목</span>
          <span class="museum-year">(2026)</span>
        </div>
        <div class="museum-artist" id="m-artist">율곡중학교 1학년 1반</div>
        <div class="museum-medium">Inkjet print on photo paper</div>
        <div class="museum-desc" id="m-desc">작품 설명이 여기에 표시됩니다.</div>
      </div>
      <div class="museum-footer-btn">
        <button class="btn-action" onclick="window.print()"><i class="fa-solid fa-print"></i> 라벨 인쇄</button>
        <button class="btn-action" onclick="closeModal('museum-label-modal')">닫기</button>
      </div>
    </div>
  </div>

  <script>
    /* ----------------------------------------------------
       1. Three.js Interactive 3D Canvas Background
    ---------------------------------------------------- */
    let scene, camera, renderer, particles;

    function init3D() {
      const container = document.getElementById('landing-canvas');
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.z = 5;

      renderer = new THREE.WebGLRenderer({ canvas: container, alpha: true, antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Create Floating Particles
      const geometry = new THREE.BufferGeometry();
      const count = 300;
      const positions = new Float32Array(count * 3);

      for (let i = 0; i < count * 3; i++) {
        positions[i] = (Math.random() - 0.5) * 12;
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const material = new THREE.PointsMaterial({
        size: 0.035,
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.7
      });

      particles = new THREE.Points(geometry, material);
      scene.add(particles);

      animate();
    }

    function animate() {
      requestAnimationFrame(animate);
      if (particles) {
        particles.rotation.y += 0.0015;
        particles.rotation.x += 0.0008;
      }
      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      if (camera && renderer) {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      }
    });

    init3D();

    function enterApp() {
      const landing = document.getElementById('landing-screen');
      landing.style.opacity = '0';
      setTimeout(() => {
        landing.style.display = 'none';
      }, 800);
    }

    /* ----------------------------------------------------
       2. File Upload Handling & Image Processing
    ---------------------------------------------------- */
    let currentBase64Image = "";

    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        alert('이미지 파일만 업로드할 수 있습니다.');
        return;
      }

      const reader = new FileReader();
      reader.onload = function(e) {
        currentBase64Image = e.target.result;
        const imgElement = document.getElementById('image-preview');
        imgElement.src = currentBase64Image;
        imgElement.style.display = 'block';
        document.getElementById('upload-placeholder').style.display = 'none';
      };
      reader.readAsDataURL(file);
    }

    /* ----------------------------------------------------
       3. Submission Management (LocalStorage / GitHub Server compatibility)
    ---------------------------------------------------- */
    function getSubmissions() {
      return JSON.parse(localStorage.getItem('yulgok_submissions') || '[]');
    }

    function saveSubmissions(data) {
      localStorage.setItem('yulgok_submissions', JSON.stringify(data));
    }

    function handleFormSubmit(event) {
      event.preventDefault();

      const grade = document.getElementById('grade-select').value;
      const classNum = document.getElementById('class-select').value;
      const title = document.getElementById('photo-title').value.trim();
      const desc = document.getElementById('photo-desc').value.trim();

      if (!currentBase64Image) {
        alert('사진을 업로드해주세요.');
        return;
      }

      const newSubmission = {
        id: Date.now(),
        grade: grade,
        classNum: classNum,
        title: title,
        desc: desc,
        image: currentBase64Image,
        createdAt: new Date().toLocaleString('ko-KR')
      };

      const submissions = getSubmissions();
      submissions.push(newSubmission);
      saveSubmissions(submissions);

      alert(`${grade}학년 ${classNum}반 작품 제출이 성공적으로 완료되었습니다!`);
      
      // Reset Form
      document.getElementById('photo-form').reset();
      document.getElementById('image-preview').style.display = 'none';
      document.getElementById('upload-placeholder').style.display = 'block';
      currentBase64Image = "";
    }

    /* ----------------------------------------------------
       4. Admin Authentication & Dashboard Functions
    ---------------------------------------------------- */
    function openAdminAuthModal() {
      document.getElementById('admin-pw').value = '';
      document.getElementById('admin-auth-modal').style.display = 'flex';
    }

    function verifyAdminPw() {
      const inputPw = document.getElementById('admin-pw').value;
      if (inputPw === '0319') {
